---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — Página no encontrada">
    <div style="min-height: calc(100vh - 60px); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem;">

        <!-- Código de error -->
        <div style="position: relative; margin-bottom: 2rem; text-align: center;">
            <p style="font-size: 8rem; font-weight: 700; color: #18181b; line-height: 1; user-select: none;">404</p>
            <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;">
                <span style="font-size: 2.5rem;">♻</span>
            </div>
        </div>

        <!-- Card -->
        <div style="border: 1px solid #27272a; background: #18181b; border-radius: 4px; overflow: hidden; width: 100%; max-width: 420px;">

            <!-- Header -->
            <div style="border-bottom: 1px solid #27272a; padding: 12px 20px; display: flex; align-items: center; gap: 8px;">
                <span style="color: #f87171; font-size: 11px;">●</span>
                <span style="font-size: 10px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: #71717a;">
                    Error 404 · Página no encontrada
                </span>
            </div>

            <!-- Body -->
            <div style="padding: 28px 24px; display: flex; flex-direction: column; gap: 16px;">

                <!-- Terminal output -->
                <div style="background: #09090b; border: 1px solid #27272a; border-radius: 3px; padding: 14px 16px; font-family: monospace;">
                    <p style="font-size: 11px; color: #52525b; margin-bottom: 8px;">$ find /page</p>
                    <p style="font-size: 11px; color: #f87171;">Error: ruta no encontrada en el sistema</p>
                    <p style="font-size: 11px; color: #52525b; margin-top: 8px;">$ <span style="color: #4ade80; animation: blink 1s step-end infinite;">▋</span></p>
                </div>

                <p style="font-size: 12px; color: #71717a; line-height: 1.6; text-align: center;">
                    La página que buscas no existe o fue movida.
                </p>

                <!-- Acciones -->
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <a
                        href="/"
                        style="width: 100%; background: #16a34a; border-radius: 3px; padding: 11px; font-size: 10px; font-family: monospace; letter-spacing: 0.12em; text-transform: uppercase; color: #fff; font-weight: 700; cursor: pointer; text-decoration: none; display: block; text-align: center; box-sizing: border-box;"
                        onmouseover="this.style.background='#15803d'"
                        onmouseout="this.style.background='#16a34a'"
                    >
                        Iniciar sesión
                    </a>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div style="margin-top: 2rem; display: flex; align-items: center; gap: 8px;">
            <span style="font-size: 14px; opacity: 0.3;">♻</span>
            <p style="font-size: 10px; color: #3f3f46; letter-spacing: 0.12em; text-transform: uppercase;">
                ReciclaTrack · Sistema de recolección
            </p>
        </div>
    </div>
</Layout>

<style>
    @keyframes blink {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0; }
    }
</style>